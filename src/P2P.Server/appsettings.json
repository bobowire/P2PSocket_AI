{
  "listen": {
    "control": 7000,
    "stunUdp": 3478,
    "stunTcp": 3478,
    "relayPorts": [ 7010, 7020 ],
    "web": 7500,
    "webBind": "127.0.0.1"
  },
  "database": {
    "path": "data/p2p.db"
  },
  "heartbeat": {
    "timeoutSec": 30
  },
  "punch": {
    "defaultConcurrency": 3,
    "timeoutSec": 10
  },
  "relay": {
    "idleTimeoutSec": 90
  },
  "logging": {
    "level": "Information",
    "retentionDays": 14
  }
}
