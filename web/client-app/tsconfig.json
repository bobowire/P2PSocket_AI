{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@p2p/ui-shared": ["../ui-shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../ui-shared/src/**/*.ts", "../ui-shared/src/**/*.vue"]
}
